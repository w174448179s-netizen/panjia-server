<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.panjia</groupId>
        <artifactId>panjia-modules</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>panjia-license</artifactId>

    <description>
        panjia-license 盘家 License 客户端校验模块
    </description>

    <dependencies>

        <!-- 盘家公共模块 -->
        <dependency>
            <groupId>com.panjia</groupId>
            <artifactId>panjia-common</artifactId>
        </dependency>

        <!-- 底座公共核心（R 等通用类） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-core</artifactId>
        </dependency>

        <!-- 底座 Web 模块（拦截器需要） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-web</artifactId>
        </dependency>

        <!-- Spring Boot 基础事件（ApplicationReadyEvent 等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>

        <!-- Hutool HTTP（调用授权服务器） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-http</artifactId>
        </dependency>

        <!-- JJWT（token 解析） -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- License 模块需要运行单元测试，覆盖父 pom 的 maven.test.skip=true -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <skip>false</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <skipTests>false</skipTests>
                    <!-- 清空父 pom 的 groups 过滤，运行所有单元测试 -->
                    <groups></groups>
                    <excludedGroups></excludedGroups>
                </configuration>
            </plugin>
            <!-- 构建时生成 LicenseMode.java（编译时常量，编译器消除死分支） -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>templating-maven-plugin</artifactId>
                <version>3.0.0</version>
                <executions>
                    <execution>
                        <id>generate-license-mode</id>
                        <goals>
                            <goal>filter-sources</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <sourceDirectory>${basedir}/src/main/templates</sourceDirectory>
                    <outputDirectory>${project.build.directory}/generated-sources/license</outputDirectory>
                </configuration>
            </plugin>
            <!-- 将生成目录加入编译源路径 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <id>add-license-mode-source</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/license</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- L3 代码保护：ProGuard 字节码混淆 -->
            <!-- 必须在 checksums 生成之前执行，确保 checksums 记录混淆后的字节码 -->
            <!-- dev 构建跳过（方便调试），prod 构建执行 -->
            <plugin>
                <groupId>com.github.wvengen</groupId>
                <artifactId>proguard-maven-plugin</artifactId>
                <version>2.6.1</version>
                <dependencies>
                    <dependency>
                        <groupId>com.guardsquare</groupId>
                        <artifactId>proguard-base</artifactId>
                        <version>7.4.0</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <phase>process-classes</phase>
                        <goals><goal>proguard</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <proguardVersion>7.4.0</proguardVersion>
                    <skip>${proguard.skip}</skip>
                    <!-- 占位 injar（classes/META-INF 无 class），真正的输入在 proguard.pro 里用 -injars 过滤器指定 -->
                    <injar>classes/META-INF</injar>
                    <proguardInclude>${basedir}/proguard.pro</proguardInclude>
                    <libs>
                        <lib>${java.home}/jmods/java.base.jmod</lib>
                    </libs>
                    <obfuscate>true</obfuscate>
                </configuration>
            </plugin>
            <!-- 将 ProGuard 混淆结果从 classes-proguard 复制回 target/classes -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>copy-obfuscated-classes</id>
                        <phase>process-classes</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <copy todir="${project.build.outputDirectory}" overwrite="true">
                                    <fileset dir="${project.build.directory}/classes-proguard"/>
                                </copy>
                                <delete dir="${project.build.directory}/classes-proguard"/>
                            </target>
                            <skip>${proguard.skip}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 构建时生成 class 校验和（打包进 JAR，运行时 IntegrityChecker 读取） -->
            <!-- 注意：ProGuard 混淆必须在此插件之前执行，确保 checksums 记录混淆后的字节码 -->
            <!-- ChecksumGenerator 在 src/test 下，用 test classpath 运行，避免被 ProGuard 混淆 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>generate-checksums</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.panjia.license.tools.ChecksumGenerator</mainClass>
                            <arguments>
                                <argument>${project.build.outputDirectory}</argument>
                            </arguments>
                            <classpathScope>runtime</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 开发构建（默认）：IDE 运行 / mvn compile → DEV=true，dev 分支保留 -->
        <!-- 生产构建必须显式指定：mvn -P prod package → DEV=false，dev 分支被编译器消除 -->
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <license.dev>true</license.dev>
                <!-- dev 构建跳过 ProGuard 混淆，方便调试 -->
                <proguard.skip>true</proguard.skip>
            </properties>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <license.dev>false</license.dev>
                <!-- prod 构建执行 ProGuard 混淆 -->
                <proguard.skip>false</proguard.skip>
                <!-- prod 构建跳过测试（混淆后测试无法编译，测试已在 dev 构建验证） -->
                <maven.test.skip>true</maven.test.skip>
            </properties>
            <build>
                <plugins>
                    <!-- ★ P0-C 构建门禁：prod 构建断言 LicenseMode.DEV 必须为 false。
                         防止 templating 插件配置漂移 / profile 失效导致发布"授权校验关闭"的产物。
                         检查点：生成源码中的常量 DEV = false（编译器据此做死代码消除）。 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>verify-license-mode-prod</id>
                                <phase>process-sources</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <loadfile property="license.mode.src"
                                                  srcFile="${project.build.directory}/generated-sources/license/com/panjia/license/LicenseMode.java"/>
                                        <condition property="license.mode.is.prod">
                                            <contains string="${license.mode.src}" substring="DEV = false"/>
                                        </condition>
                                        <fail unless="license.mode.is.prod"
                                              message="[P0-C 构建门禁] 生产构建校验失败：LicenseMode.DEV != false（当前生成值见 target/generated-sources/license）。此产物授权校验处于关闭状态，禁止发布。请检查 templating-maven-plugin 配置与 license.dev 属性。"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>default-testCompile</id>
                                <configuration>
                                    <skip>true</skip>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                            <skipTests>true</skipTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
