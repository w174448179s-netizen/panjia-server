# ============================================================
# 盘家智管 · 生产环境环境变量配置
# ============================================================
# 使用方式：
#   1. 复制本文件为 .env：cp .env.example .env
#   2. 修改 .env 中的所有密码和配置项
#   3. 切勿将 .env 提交到 Git（已加入 .gitignore）
# ============================================================

# ==================== PostgreSQL 数据库 ====================
POSTGRES_USER=panjia
POSTGRES_PASSWORD=Panjia@Prod2026
POSTGRES_DB=panjia
POSTGRES_PORT=5432

# ==================== Redis 缓存 ====================
REDIS_PASSWORD=Panjia@Redis2026
REDIS_PORT=6379

# ==================== MinIO 对象存储 ====================
MINIO_ROOT_USER=panjia
MINIO_ROOT_PASSWORD=Panjia@Minio2026
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ==================== 盘家智管后端 ====================
ADMIN_PORT=8080

# ==================== License 授权 ====================
# 授权服务器地址（我方 License 服务）
LICENSE_SERVER_URL=https://license.panjia.com
# 授权码：由管理后台生成，首次部署时填入
# 激活成功后作废，后续重启自动从持久化 token 恢复，无需保留
PANJIA_AUTH_CODE=
