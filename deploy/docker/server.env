# 当前客户服务器配置（部署脚本不传参数时自动读取）
# 换客户部署时改这里的 IP 即可，或直接 bash deploy.sh <新IP> 覆盖
SERVER_IP=162.14.72.197
SERVER_USER=ubuntu
INSTALL_DIR=/home/ubuntu/panjia

# ---- 腾讯云 API 密钥（可选：setup-server.sh 自动放行云防火墙/安全组用）----
# 控制台 → 访问管理 CAM → API 密钥管理；建议子用户密钥，按机器类型授权：
#   CVM：QcloudCVMReadOnlyAccess + QcloudVPCFullAccess / 轻量服务器：QcloudLighthouseFullAccess
# 不配置则安全组需手工在控制台放行；此文件已加 .gitignore，密钥不会入库
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=
