<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.panjia</groupId>
        <artifactId>panjia-modules</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>panjia-import</artifactId>

    <description>
        panjia-import 数据导入域（Excel 导入模板、归一化流水线前置）
    </description>

    <dependencies>
        <!-- 盘家公共模块 -->
        <dependency>
            <groupId>com.panjia</groupId>
            <artifactId>panjia-common</artifactId>
        </dependency>

        <!-- 底座公共核心（R 等通用类） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-core</artifactId>
        </dependency>

        <!-- 底座 MyBatis-Plus（BaseMapper、@Version 等） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-mybatis</artifactId>
        </dependency>

        <!-- 契约层（PeopleQueryPort 员工匹配端口 / NormalizedRecordFields 白名单） -->
        <dependency>
            <groupId>com.panjia</groupId>
            <artifactId>panjia-contracts</artifactId>
        </dependency>

        <!-- 公共导入工具层（文件解析/模板解析/归档/基础校验，V2.0） -->
        <dependency>
            <groupId>com.panjia</groupId>
            <artifactId>common-import-util</artifactId>
        </dependency>

        <!-- 底座 JSON（Jackson ObjectMapper：rawJson/extraJson 序列化） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-json</artifactId>
        </dependency>

        <!-- 底座 Web（@RestController / @SaCheckPermission） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-web</artifactId>
        </dependency>

        <!-- 底座 sa-token（权限注解 + LoginHelper） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-satoken</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit5（CI: check-import-template-static 校验种子数据） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit 架构守护测试 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 剔除 U*.sql 回滚脚本：U 脚本仅本地调试用，禁止进交付包（00 卡 §三）。
                 Flyway 社区版不执行 U 脚本，但其会随 jar 进入 BOOT-INF/lib 最终交付包，
                 在此处从源头上排除，任何打包路径（installer/upgrade/CI）自动生效。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/db/migration/U*.sql</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
