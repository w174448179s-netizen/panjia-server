<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.panjia</groupId>
        <artifactId>panjia-modules</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>panjia-received</artifactId>

    <description>
        panjia-received 实收业绩域（从 performance 域独立）
        仅依赖 contracts 契约层 + common 公共，不直连 performance 域。
        跨域访问通过 contracts 端口接口（CommissionPerformanceQueryPort/ReceivedApplyPort）。
    </description>

    <dependencies>
        <!-- 底座公共 -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-satoken</artifactId>
        </dependency>

        <!-- panjia-contracts 契约层（跨域端口接口 + DTO） -->
        <dependency>
            <groupId>com.panjia</groupId>
            <artifactId>panjia-contracts</artifactId>
        </dependency>

        <!-- panjia-common 公共工具 -->
        <dependency>
            <groupId>com.panjia</groupId>
            <artifactId>panjia-common</artifactId>
        </dependency>

        <!-- panjia-performance（临时依赖，后续渐进式解耦为 contracts 端口接口） -->
        <dependency>
            <groupId>com.panjia</groupId>
            <artifactId>panjia-performance</artifactId>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>

        <!-- ArchUnit（CI 架构约束：实收域严禁依赖 performance 域） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
