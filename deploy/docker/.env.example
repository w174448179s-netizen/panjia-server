# ============================================================================
# 盘家智管生产环境变量配置模板
# 复制为 .env 后修改所有密码！
# ============================================================================

# ---- PostgreSQL ----
POSTGRES_USER=panjia
POSTGRES_PASSWORD=请改成强密码_至少16位_含大小写数字符号
POSTGRES_DB=panjia
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PASSWORD=请改成强密码_至少16位
REDIS_PORT=6379

# ---- MinIO 对象存储 ----
MINIO_ROOT_USER=panjia
MINIO_ROOT_PASSWORD=请改成强密码_至少16位
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- License 授权 ----
# 首次部署必填：由授权管理后台生成的授权码，后端启动时自动激活
# 激活成功后 token 持久化在 data/panjia-license/，可清空此值
PANJIA_AUTH_CODE=

# ---- 镜像标签 ----
IMAGE_TAG=latest

# ---- 前端映射端口（唯一对公网发布的端口）----
WEB_PORT=80

# 说明：后端 8080 不发布到宿主机，nginx 在容器内网反代 server:8080；
# PostgreSQL/Redis/MinIO 端口仅绑定宿主机 127.0.0.1，需要调试走 SSH 隧道：
#   ssh -L 5432:127.0.0.1:5432 ubuntu@服务器IP

# ---- JVM 参数（根据服务器内存调整）----
# 2G 内存服务器：-Xms512m -Xmx1024m
# 4G 内存服务器：-Xms1024m -Xmx2048m
# 8G 内存服务器：-Xms2048m -Xmx4096m
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC
