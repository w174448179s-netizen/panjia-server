<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.panjia</groupId>
        <artifactId>panjia-modules</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>panjia-contracts</artifactId>

    <description>
        panjia-contracts 契约层（叶子模块：事件接口、Snapshot、DTO、异常常量、反向字典接口）
    </description>

    <dependencies>
        <!-- 底座公共核心（R、ServiceException 等通用类） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-core</artifactId>
        </dependency>

        <!-- Jackson 注解（@JsonValue 序列化 OutboxStatusEnum）。
             注意：Jackson 3 仅 jackson-core/jackson-databind 迁移到 tools.jackson 包，
             注解包仍为 com.fasterxml.jackson.annotation（jackson-databind 3.x 自身依赖本坐标）。
             本模块只需注解，禁止引入 jackson-databind 2.x（会把 Jackson 2 的
             com.fasterxml.jackson.databind.ObjectMapper 带入编译类路径，误用后容器无此 Bean）。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>

        <!-- Lombok（@Data） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ArchUnit 架构测试（CI：事件 payload 无 @Entity / contracts 不依赖业务域 / 禁止 @Value） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit5（surefire 发现 @Test） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
