# ============================================================================
# 盘家智管生产环境变量配置模板
# 复制为 .env 后修改所有密码！
# ============================================================================

# ---- PostgreSQL ----
POSTGRES_USER=panjia
POSTGRES_PASSWORD=请改成强密码_至少16位_含大小写数字符号
POSTGRES_DB=panjia
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PASSWORD=请改成强密码_至少16位
REDIS_PORT=6379

# ---- MinIO 对象存储（内置容器模式）----
# 用本机 compose 自带 minio 容器时保留；迁到独立 MinIO 服务器时见文件末尾"外部 MinIO"段
MINIO_ROOT_USER=panjia
MINIO_ROOT_PASSWORD=请改成强密码_至少16位
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- License 授权 ----
# 首次部署必填：由授权管理后台生成的授权码，后端启动时自动激活
# 激活成功后 token 持久化在 data/panjia-license/，可清空此值
PANJIA_AUTH_CODE=
# 授权服务器地址（默认指向主站 console 的 /api/auth）
PANJIA_LICENSE_SERVER_URL=https://panjia.online
# SSL Pinning 证书指纹（SHA-256 小写无冒号）：主=当前证书，备=轮换过渡期证书
# 证书续签后必须更新主指纹，否则心跳会因指纹未命中失败
PANJIA_PIN_FP_A=5f9a4d5dda12751bfa7a7d5fd490a83d5ae0e6aae5abc6eb06a64e21a41e94ce
PANJIA_PIN_FP_B=

# ---- 钉钉集成（人员 / 考勤同步）----
# 凭证只在部署机 .env 中维护（本文件与 .env 均不入库），后端 application.yml 只引用环境变量
# 开发者后台 → 应用信息 → 凭证与基础信息 → Client ID / Client Secret
PANJIA_DINGTALK_ENABLED=false
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_AGENT_ID=5111097099
# 每日同步（人员 + 考勤）cron，默认每晚 23:30
DINGTALK_SYNC_CRON="0 30 23 * * ?"

# ---- 镜像标签 ----
IMAGE_TAG=latest

# ---- 前端映射端口（唯一对公网发布的端口）----
WEB_PORT=80

# ---- HTTPS 域名（可选，默认纯 HTTP；通常不用手填，DOMAIN=xxx 跑 deploy.sh 自动写入）----
# 首次带 DOMAIN 部署后脚本自动补齐下面三项，certbot 负责证书申请与每日自动续签：
#   DOMAIN=panjia.online                         # 真实域名（A 记录已指本机、已 ICP 备案）
#   NGINX_CONF=nginx-https.enabled.conf          # compose 挂载这份 HTTPS 配置
#   WEB_HTTPS_BIND=443                           # 对公网发布 443
# 留空/删除这三项即回退纯 HTTP（测试环境始终不填，443 默认只绑 127.0.0.1:1443）
# 安全组需放行 80（HTTP 跳转 + ACME 续签）和 443（HTTPS）

# 说明：后端 8080 不发布到宿主机，nginx 在容器内网反代 server:8080；
# PostgreSQL/Redis/MinIO 端口仅绑定宿主机 127.0.0.1，需要调试走 SSH 隧道：
#   ssh -L 5432:127.0.0.1:5432 ubuntu@服务器IP

# ---- JVM 参数（根据服务器内存调整）----
# 2G 内存服务器：-Xms512m -Xmx1024m
# 4G 内存服务器：-Xms1024m -Xmx2048m
# 8G 内存服务器：-Xms2048m -Xmx4096m
# 值含空格必须加双引号（deploy.sh 会 source 本文件，无引号会把 -Xmx 当命令执行报错）
JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC"

# ============================================================================
# 外部独立 MinIO 模式（可选）——文件服务拆到另一台服务器时使用
# ----------------------------------------------------------------------------
# 步骤：
#   1) 文件服务器跑好 MinIO，安全组 9000 只对应用服务器 IP 放行
#   2) 旧数据迁移（应用服务器上执行，mc 在 minio 镜像里）：
#        docker run --rm --entrypoint sh pgsty/minio:RELEASE.2026-04-17T00-00-00Z -c '
#          mc alias set old http://127.0.0.1:9000 旧AK 旧SK
#          mc alias set new http://文件服务器IP:9000 新AK 新SK
#          mc mirror --overwrite old/panjia-archive new/panjia-archive'
#   3) 取消下面注释并填好 → COMPOSE_PROFILES 置空（内置 minio 容器不再启动）
#   4) 后台「系统管理 → OSS 配置」同步改通用文件服务的 endpoint/AK/SK
#   5) sudo ./restart.sh
# 提示：endpoint 建议用域名（如 http://oss.客户域名:9000），以后再迁移只改 DNS
# ============================================================================
# COMPOSE_PROFILES=
# PANJIA_IMPORT_MINIO_ENDPOINT=http://文件服务器IP:9000
# PANJIA_IMPORT_MINIO_ACCESS_KEY=外部MinIO账号
# PANJIA_IMPORT_MINIO_SECRET_KEY=外部MinIO密码
# PANJIA_IMPORT_MINIO_BUCKET=panjia-archive
