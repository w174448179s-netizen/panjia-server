<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.panjia</groupId>
        <artifactId>panjia-modules</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>common-import-util</artifactId>

    <description>
        common-import-util 公共导入工具层（文件解析/模板解析/归档/基础格式校验）。
        工具层自带字典中心查询（DefaultSysDictDataAdapter 走 ISysDictDataService），
        业务域无需再写 Adapter。V6.0.1 起打破「纯技术无业务依赖」约束，
        ArchUnit 红线相应放宽：仅保留「不得依赖 importdomain / people 业务域」约束，
        mybatis-plus 间接依赖（来自 ruoyi-system）允许通过。
    </description>

    <dependencies>
        <!-- Excel 解析（fesod = EasyExcel/FastExcel fork） -->
        <dependency>
            <groupId>org.apache.fesod</groupId>
            <artifactId>fesod-sheet</artifactId>
        </dependency>

        <!-- POI（用于 Excel 模板写入，fesod-sheet 传递依赖） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.1</version>
        </dependency>

        <!-- Spring 自动装配（@AutoConfiguration / @ConfigurationProperties） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- S3 / MinIO 归档（基于 AWS SDK v2，MinIO 兼容 S3 协议） -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-common-oss</artifactId>
        </dependency>

        <!--
          RuoYi 系统模块（用于字典中心查询）。
          V6.0.1 起 common-import-util 内置 DefaultSysDictDataAdapter 走 ISysDictDataService，
          让 dict_in:DICT_TYPE 校验真正落到字典中心，业务域无需再写 Adapter。
          注意：本模块不直接用 Mapper，只走 service 接口；mybatis-plus 是 ruoyi-system 的传递依赖，
          ArchUnit 红线已相应放宽（保留「禁止依赖业务域」约束，删 mybatis/mybatis-plus 红线）。
        -->
        <dependency>
            <groupId>org.dromara</groupId>
            <artifactId>ruoyi-system</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit 架构守护测试 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
